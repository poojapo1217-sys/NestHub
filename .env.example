# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server Configuration
PORT=3000
NODE_ENV="development"

# JWT Authentication Secret (Change in production!)
JWT_SECRET="comfort-stay-pg-dev-jwt-secret-change-in-prod"
JWT_EXPIRES_IN="7d"

# MySQL Database Configuration (Optional: Leave DB_HOST empty to use built-in SQLite local persistence)
DB_CLIENT="sqlite"
DB_HOST=""
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="pg_hostel_management"
SQLITE_PATH="./data/pg_hostel_management.db"

# Uploads
UPLOAD_DIR="./uploads"
